{
  "name": "hebrah-mcp-host",
  "version": "0.1.0",
  "description": "Open-source MCP server (Streamable HTTP) for the Hebrah platform. Bridges Cursor, Claude Code, and other MCP clients to the Hebrah dashboard and control plane.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hebrah",
    "healthcare",
    "fhir",
    "fhir-client",
    "hl7",
    "hl7v2",
    "ehr",
    "emr",
    "sandbox",
    "webhooks",
    "agents",
    "agent-tools",
    "claude",
    "anthropic",
    "cursor",
    "ai-agents"
  ],
  "homepage": "https://hebrah.com",
  "bugs": {
    "url": "https://github.com/Hebrah-inc/hebrah-mcp-host/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Hebrah-inc/hebrah-mcp-host.git"
  },
  "scripts": {
    "predev": "node scripts/sync-sdk-reference.mjs || true",
    "prebuild": "node scripts/sync-sdk-reference.mjs || true",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "hono": "^4.7.11",
    "ioredis": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.1.3",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ]
}