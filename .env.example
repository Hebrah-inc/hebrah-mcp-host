# HTTP listen port (local default: 3021)
PORT=3021

# hebrah-app — PAT validation + dashboard API proxy
HEBRAH_DASHBOARD_URL=http://localhost:3000

# hebrah-api — sandbox catalog + mock webhook trigger
HEBRAH_API_URL=http://localhost:8000

# Org sandbox API key from hebrah onboarding Step 2 (hb_test_*)
# Required for get_sandbox_catalog and trigger_test_webhook — NOT the hb_pat_* token
HEBRAH_SANDBOX_API_KEY=hb_test_your_key_here

# Shared secret with hebrah-app — run: bash ../scripts/generate-local-secrets.sh
# Must be >= 32 chars; server refuses to start otherwise.
MCP_INTERNAL_SECRET=

# Optional Redis for shared rate-limit counters (rate limits fall back to in-memory if unset)
# REDIS_URL=redis://localhost:6379

# HL7 orchestrator (hebrah-api golden-qemu backend) for flight checks
ORCHESTRATOR_URL=http://localhost:8090
ORCHESTRATOR_SECRET=

# hebrah-integration-agent — synthetic EHR / BYOM model generation
INTEGRATION_AGENT_URL=http://localhost:3050